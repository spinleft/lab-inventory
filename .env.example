# Lab Inventory 部署配置。复制为 .env 后按需修改。
#
#     cp .env.example .env
#
# 带 "必填" 的项没有默认值,不填 docker compose up 会直接报错退出。
# 完整的配置项说明见 docs/configuration.md。

# ---------------------------------------------------------------------------
# 必填
# ---------------------------------------------------------------------------

# 用户在浏览器里访问本系统的地址,必须是外部可达的完整 URL。
# 二维码里的链接、联邦握手时报给对方的地址都用它,填错会导致扫码打不开。
PUBLIC_URL=https://inventory.example.com

# 会话 Cookie 和访客注册码的签名密钥。至少 64 个字符的随机串:
#     openssl rand -base64 48
# 换掉它会让所有已登录用户掉线。绝不要提交到 git。
HMAC_SECRET=

# Postgres 密码。首次 docker compose up 时创建数据库用,之后不要再改
# (改了要同时改数据库里的密码,否则后端连不上)。
POSTGRES_PASSWORD=

# root 账号的初始密码,至少 8 个字符。
# 只在首次启动时生效:它替换掉迁移脚本里那个公开的默认密码。之后在界面上
# 改过密码,这里的值就不再起作用,不会把密码改回去。
INITIAL_ROOT_PASSWORD=

# ---------------------------------------------------------------------------
# 可选
# ---------------------------------------------------------------------------

# 要部署的版本。对应 GitHub Release 的 tag(不带 v 前缀)。
LAB_INVENTORY_VERSION=0.1.0

# 宿主机上监听的端口。前面通常还有一层反向代理负责 HTTPS。
HTTP_PORT=8080

# Postgres 的用户名和库名。首次启动后不要再改。
POSTGRES_USER=lab_inventory
POSTGRES_DB=lab_inventory

# 会话 Cookie 是否只在 HTTPS 下发送。默认 true;只有在内网用纯 HTTP 访问时
# 才改成 false,否则浏览器会丢弃 Cookie,表现为"登录后立刻退回登录页"。
COOKIE_SECURE=true

# 额外放行的跨域来源,多个用逗号分隔:
#     CORS_ALLOWED_ORIGINS=https://inventory.example.com
# 浏览器访问是同源的,不需要配置;前端和后端分开部署在不同来源时才需要。
# 桌面端 / 安卓端的请求由客户端原生发出,不受同源策略约束,不用配。
CORS_ALLOWED_ORIGINS=

# 是否开启实验室联邦(跨实例互相查看、借用物资)。
# 开启前请先读 docs/federation.md,它要求 PUBLIC_URL 是 HTTPS。
FEDERATION_ENABLED=false

# ---------------------------------------------------------------------------
# 仅 docker-compose.external.yml 需要
#
# 用外部的 Postgres 和 Redis 时才填。上面的 POSTGRES_* 那几项这时不起作用。
# ---------------------------------------------------------------------------

#DATABASE_HOST=db.internal
#DATABASE_PORT=5432
#DATABASE_USERNAME=lab_inventory
#DATABASE_PASSWORD=
#DATABASE_NAME=lab_inventory
# 走网络连数据库,默认要求 TLS。数据库不支持时才关掉。
#DATABASE_REQUIRE_SSL=true

#REDIS_URI=redis://redis.internal:6379
