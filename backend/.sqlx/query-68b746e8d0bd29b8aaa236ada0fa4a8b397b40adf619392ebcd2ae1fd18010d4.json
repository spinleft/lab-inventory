  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            location_id,\n            laboratory_id,\n            parent_location_id,\n            name,\n            code,\n            path::text AS \"path!\",\n            depth,\n            description,\n            created_at,\n            updated_at\n        FROM locations\n        WHERE laboratory_id = $1\n          AND ($2::text IS NULL OR path <@ $2::text::ltree)\n        ORDER BY path\n        ",
