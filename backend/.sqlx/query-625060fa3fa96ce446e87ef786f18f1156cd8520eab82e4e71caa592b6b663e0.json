  "query": "\n        SELECT\n            category_id,\n            laboratory_id,\n            parent_category_id,\n            name,\n            code,\n            path::text AS \"path!\",\n            depth,\n            description,\n            created_at,\n            updated_at\n        FROM asset_categories\n        WHERE laboratory_id = $1\n          AND path <@ $2::text::ltree\n        ORDER BY path\n        FOR UPDATE\n        ",
