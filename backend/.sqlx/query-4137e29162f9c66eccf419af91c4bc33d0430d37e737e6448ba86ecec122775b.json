  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            inventory_item_id,\n            asset_id,\n            laboratory_id,\n            tracking_mode,\n            serial_number,\n            batch_number,\n            quantity_on_hand::double precision AS \"quantity_on_hand!\",\n            quantity_allocated::double precision AS \"quantity_allocated!\",\n            location_id,\n            status,\n            public_notes,\n            internal_notes,\n            created_at,\n            updated_at,\n            last_stocktake_at\n        FROM asset_inventory_items\n        WHERE asset_id = $1\n        ORDER BY created_at, inventory_item_id\n        FOR UPDATE\n        ",
